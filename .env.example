# ==========================================================
# 模式一：智能机器人长连接（默认）——群里必须 @机器人 才收得到
# ==========================================================
WECOM_BOT_ID=
WECOM_SECRET=
# Optional: wss://openws.work.weixin.qq.com
# WECOM_WS_URL=

# 群机器人 Webhook：加到群里就能无 @ 推送（推荐，发送通道）
WECOM_WEBHOOK_KEY=

# ==========================================================
# 模式二：会话内容存档——群里不 @ 也能收到全部消息
# 配了 WECOM_MSGAUDIT_CORPID 就自动切到这个模式
# ==========================================================
# 管理后台 -> 我的企业 -> 企业信息 -> 企业ID
WECOM_MSGAUDIT_CORPID=
# 管理后台 -> 安全与管理 -> 管理工具 -> 会话内容存档 -> Secret
WECOM_MSGAUDIT_SECRET=
# 自己生成的 RSA 私钥（公钥要上传到上面的存档页面）
WECOM_MSGAUDIT_PRIVATE_KEY=keys/msgaudit_private.pem
# 官方原生 SDK 路径（Windows 是 WeWorkFinanceSdk.dll）
WECOM_SDK_DLL=
